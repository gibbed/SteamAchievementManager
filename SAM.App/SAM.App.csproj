<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SAM.App</RootNamespace>
    <AssemblyName>SAM</AssemblyName>
    <Version>7.0.0</Version>
    <Product>Steam Achievement Manager</Product>
    <AssemblyTitle>Steam Achievement Manager</AssemblyTitle>
    <Description>Steam Achievement Manager as a WinUI 3 app.</Description>
    <Company>Gibbed</Company>
    <Copyright>Copyright © Gibbed 2019</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SAM.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultLanguage>en-US</DefaultLanguage>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Translations, maintained with tools/strings.py -->
    <EmbeddedResource Include="Strings\*.json" LogicalName="SAM.App.Strings.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the parts of the Windows App SDK 1.8 that are needed - without the AI, ML and widget runtimes (saves ~60 MB). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260803002" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="1.8.25122902" />
  </ItemGroup>

  <ItemGroup>
    <!-- Schema reader and stat definitions are shared with SAM.Game rather than copied. -->
    <Compile Include="..\SAM.Game\KeyValue.cs" Link="Schema\KeyValue.cs" />
    <Compile Include="..\SAM.Game\KeyValueType.cs" Link="Schema\KeyValueType.cs" />
    <Compile Include="..\SAM.Game\StreamHelpers.cs" Link="Schema\StreamHelpers.cs" />
    <Compile Include="..\SAM.Game\Stats\*Definition.cs" Link="Schema\%(Filename).cs" />
    <Compile Include="..\SAM.Game\Stats\StatFlags.cs" Link="Schema\StatFlags.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SAM.API.x64\SAM.API.x64.csproj" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SAM.App.Columns.ColumnChooserView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cols="using:SAM.App.Columns"
    xmlns:loc="using:SAM.App.Localization">

    <!-- Which columns are shown and in which order; every change applies immediately -->
    <StackPanel Width="320" Spacing="10">
        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind loc:Strings.ColumnsButton}" />
        <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind loc:Strings.ColumnsHint}" TextWrapping="Wrap" />

        <ListView
            x:Name="ColumnsList"
            Margin="-12,0"
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="True"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="12,0,8,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="cols:ColumnChoice">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Margin="0,0,8,0" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE76F;" />
                        <CheckBox Grid.Column="1" Content="{x:Bind Header}" IsChecked="{x:Bind IsVisible, Mode=TwoWay}" IsEnabled="{x:Bind CanHide}" />
                        <Button
                            Grid.Column="2"
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind MoveUpLabel}"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind loc:Strings.MoveUp}"
                            Tag="{x:Bind Key}"
                            Click="OnMoveUpClick">
                            <FontIcon FontSize="12" Glyph="&#xE70E;" />
                        </Button>
                        <Button
                            Grid.Column="3"
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind MoveDownLabel}"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind loc:Strings.MoveDown}"
                            Tag="{x:Bind Key}"
                            Click="OnMoveDownClick">
                            <FontIcon FontSize="12" Glyph="&#xE70D;" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button HorizontalAlignment="Left" Content="{x:Bind loc:Strings.ColumnsReset}" Click="OnResetClick" />
    </StackPanel>
</UserControl>

<Window x:Class="SAM.Picker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAM.Picker"
        mc:Ignorable="d"
        Title="Steam Achievement Manager 7.0" Height="600" Width="1000"
        Background="#121212"
        WindowStartupLocation="CenterScreen"
        Foreground="White">

    <Grid Margin="20" Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Steam Achievement Manager" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Select a game to manage its achievements" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Search Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Grid Grid.Column="0">
                <TextBox x:Name="SearchBox" FontSize="16" Height="40" VerticalContentAlignment="Center"
                         HorizontalAlignment="Stretch" Padding="40,5,10,5"
                         TextChanged="OnSearchTextChanged"/>
                <!-- Search Icon -->
                <Path Data="M15.5,14L20.3,18.8L18.8,20.3L14,15.5C12.9,16.4 11.5,17 10,17A7,7 0 0,1 3,10A7,7 0 0,1 10,3A7,7 0 0,1 17,10C17,11.5 16.4,12.9 15.5,14M10,5A5,5 0 0,0 5,10A5,5 0 0,0 10,15A5,5 0 0,0 15,10A5,5 0 0,0 10,5Z" 
                      Fill="{StaticResource TextSecondaryBrush}" Stretch="Fill" Width="18" Height="18" 
                      HorizontalAlignment="Left" Margin="15,0,0,0" VerticalAlignment="Center"/>
                <TextBlock IsHitTestVisible="False" Text="Search for a game by name or ID..." 
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="45,0,0,0" 
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=SearchBox, Path=Text}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button Grid.Column="1" Content="Add Game" Margin="10,0,0,0" Padding="20,0" 
                    Background="#2C3E50" Foreground="#3498DB" BorderBrush="#3498DB" BorderThickness="1"
                    Click="OnAddGameClick" FontWeight="SemiBold"/>
        </Grid>

        <!-- Game List (Grid Layout) -->
        <ListBox Grid.Row="2" x:Name="GamesListBox" 
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="OnGameDoubleClicked">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="10" Width="184" Height="120" Background="#1A1B1E" CornerRadius="12" 
                            BorderBrush="#2C2E33" BorderThickness="1">
                        <Grid>
                            <Image Source="{Binding Image}" Stretch="UniformToFill" Opacity="0.5">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,184,120" RadiusX="12" RadiusY="12"/>
                                </Image.Clip>
                            </Image>
                            <Border Background="Transparent" CornerRadius="12"/>
                            <StackPanel VerticalAlignment="Bottom" Margin="10">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold" 
                                           TextWrapping="Wrap" MaxHeight="40" TextAlignment="Center" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Status Bar -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <TextBlock x:Name="StatusLabel" Text="Initializing Steam..." Foreground="{StaticResource TextSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="DownloadStatusLabel" Text="Downloading icons..." Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" Margin="0,0,15,0"/>
                <TextBlock Text="v7.6 (Global Engine)" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.5" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
